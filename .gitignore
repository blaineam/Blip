# Xcode
*.xcodeproj
*.xcworkspace
xcuserdata/
DerivedData/
build/
dist/
*.app
*.dSYM
*.dSYM.zip

# Swift Package Manager
.build/
Packages/
Package.resolved

# macOS
.DS_Store
*.swp
*~

# Signing & Secrets
*.p12
*.cer
*.key
*.pem
*.mobileprovision
*.provisionprofile
Keychain/
.env
.env.*

# Build artifacts
*.dmg
*.zip
*.ipa
.claude/
.build-screenshots/
screenshots/

# Coverage artifacts
*.profraw

# Xcode Cloud runs with automatic SwiftPM resolution disabled and needs the
# workspace Package.resolved checked in (negation chain; last rules win):
!Blip.xcodeproj/
Blip.xcodeproj/*
!Blip.xcodeproj/project.xcworkspace/
Blip.xcodeproj/project.xcworkspace/*
!Blip.xcodeproj/project.xcworkspace/xcshareddata/
Blip.xcodeproj/project.xcworkspace/xcshareddata/*
!Blip.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/
Blip.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/*
!Blip.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
