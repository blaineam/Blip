    "Low Power Mode is still on while charging above 80% — background refresh and performance stay reduced until you switch it off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stromsparmodus ist beim Laden über 80 %% noch aktiv — Hintergrundaktualisierung und Leistung bleiben reduziert, bis du ihn ausschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de bajo consumo sigue activo cargando por encima del 80 %%: la actualización en segundo plano y el rendimiento siguen reducidos hasta que lo desactives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode économie d'énergie est encore actif au-dessus de 80 %% de charge — l'actualisation en arrière-plan et les performances restent réduites tant qu'il est activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risparmio energetico è ancora attivo con carica oltre l'80 %%: aggiornamento in background e prestazioni restano ridotti finché non lo disattivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電80%%を超えても低電力モードがオンのままです。オフにするまでバックグラウンド更新と性能は抑えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전 80%%가 넘었는데도 저전력 모드가 켜져 있습니다 — 끄기 전까지 백그라운드 새로 고침과 성능이 계속 제한됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de baixo consumo continua ativo carregando acima de 80%% — atualização em segundo plano e desempenho ficam reduzidos até você desligá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量已充至 80%% 以上，低电量模式仍开启 —— 关闭前后台刷新和性能都会持续受限。"
          }
        }
      }
    },
