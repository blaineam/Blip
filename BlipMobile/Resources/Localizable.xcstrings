    "On battery — scores can read low. Plug in for a fair full run.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Batteriebetrieb können Werte niedriger ausfallen. Für einen fairen Volllauf ans Netz anschließen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con batería, los resultados pueden salir bajos. Conéctalo para una prueba completa justa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur batterie, les scores peuvent être sous-évalués. Branchez l'appareil pour un test complet équitable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A batteria i punteggi possono risultare bassi. Collega l'alimentazione per un test completo equo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー使用中はスコアが低く出ることがあります。正確なフル測定には電源に接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 사용 중에는 점수가 낮게 나올 수 있습니다. 공정한 전체 측정을 위해 전원에 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na bateria, as pontuações podem sair baixas. Conecte à energia para um teste completo justo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用电池时分数可能偏低。连接电源以获得公平的完整测试结果。"
          }
        }
      }
    },
