    "Storage is nearly full (%@ left). iOS slows down and updates fail below ~1 GB — offload unused apps or large videos in Settings → General → iPhone Storage.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher ist fast voll (%@ übrig). Unter ~1 GB wird iOS langsam und Updates schlagen fehl — lagere ungenutzte Apps oder große Videos unter Einstellungen → Allgemein → iPhone-Speicher aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento está casi lleno (queda %@). Con menos de ~1 GB, iOS va lento y las actualizaciones fallan: descarga apps sin usar o vídeos grandes en Ajustes → General → Almacenamiento del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage est presque plein (%@ restant). Sous ~1 Go, iOS ralentit et les mises à jour échouent — déchargez des apps inutilisées ou de grosses vidéos dans Réglages → Général → Stockage iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archiviazione è quasi piena (%@ rimasti). Sotto ~1 GB iOS rallenta e gli aggiornamenti falliscono: scarica app inutilizzate o video pesanti in Impostazioni → Generali → Spazio iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージがほぼ満杯です（残り%@）。約1GBを切るとiOSは遅くなり、アップデートも失敗します。「設定」→「一般」→「iPhoneストレージ」で未使用のAppや大きなビデオを整理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 거의 찼습니다(%@ 남음). 약 1GB 미만이면 iOS가 느려지고 업데이트가 실패합니다 — 설정 → 일반 → iPhone 저장 공간에서 안 쓰는 앱이나 큰 비디오를 정리하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento está quase cheio (%@ restantes). Abaixo de ~1 GB o iOS fica lento e atualizações falham — descarregue apps sem uso ou vídeos grandes em Ajustes → Geral → Armazenamento do iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储空间即将用尽（剩余 %@）。低于约 1 GB 时 iOS 会变慢、更新会失败 —— 请在「设置」→「通用」→「iPhone 存储空间」中卸载未使用的 App 或整理大视频。"
          }
        }
      }
    },
