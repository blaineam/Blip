    },
    "Memory available to apps is low (%@). Heavy apps may relaunch from scratch; closing camera- and game-class apps you're done with helps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Apps verfügbarer Speicher ist knapp (%@). Große Apps starten evtl. neu; das Schließen nicht mehr benötigter Kamera- und Spiele-Apps hilft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria disponible para apps es baja (%@). Las apps pesadas pueden reiniciarse desde cero; ayuda cerrar apps de cámara y juegos que ya no uses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire disponible pour les apps est faible (%@). Les grosses apps peuvent redémarrer de zéro ; fermer les apps photo et jeux terminées aide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria disponibile per le app è bassa (%@). Le app pesanti potrebbero ripartire da zero; chiudere fotocamera e giochi che non usi più aiuta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App使用可能なメモリが少なくなっています（%@）。大きなAppは最初から再起動されることがあります。使い終えたカメラ系・ゲーム系Appを閉じると改善します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 사용 가능 메모리가 부족합니다(%@). 무거운 앱이 처음부터 다시 실행될 수 있습니다. 다 쓴 카메라·게임류 앱을 닫으면 도움이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória disponível para apps está baixa (%@). Apps pesados podem reiniciar do zero; fechar apps de câmera e jogos que você já terminou ajuda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可供 App 使用的内存不足（%@）。大型 App 可能需要从头重新启动；关闭用完的相机类和游戏类 App 会有帮助。"
          }
        }
      }
    },
