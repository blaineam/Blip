    "All bars match the system menu bar icon color.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Balken verwenden die Symbolfarbe der Menüleiste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las barras usan el color de los iconos de la barra de menús del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les barres adoptent la couleur des icônes de la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le barre usano il colore dell'icona nella barra dei menu di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのバーをシステムのメニューバーアイコンの色に合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 막대가 시스템 메뉴 막대 아이콘 색상을 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as barras usam a cor do ícone da barra de menus do sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有条形图使用系统菜单栏图标颜色。"
          }
        }
      }
    },
