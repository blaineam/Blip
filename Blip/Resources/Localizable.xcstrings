    "%@ is current-value only — Blip doesn't keep history for it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nur ein aktueller Wert – Blip speichert dafür keinen Verlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo tiene valor actual: Blip no guarda su historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'affiche que la valeur actuelle — Blip n'en conserve pas l'historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mostra solo il valore attuale — Blip non ne conserva la cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は現在値のみです — Blip は履歴を保存しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 현재 값만 제공합니다 — Blip은 기록을 보관하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mostra apenas o valor atual — o Blip não mantém histórico dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 仅显示当前值 — Blip 不会保存其历史记录。"
          }
        }
      }
    },
