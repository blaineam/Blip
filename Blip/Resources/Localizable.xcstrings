    "Checks DB-IP about once a day and downloads a newer monthly release when one is available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft etwa einmal täglich bei DB-IP und lädt eine neuere monatliche Version, sobald eine verfügbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba DB-IP una vez al día aproximadamente y descarga la nueva versión mensual cuando hay una disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie DB-IP environ une fois par jour et télécharge la nouvelle version mensuelle dès qu'elle est disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla DB-IP circa una volta al giorno e scarica la nuova versione mensile quando è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 日に 1 回程度 DB-IP を確認し、新しい月次リリースがあればダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루에 한 번 정도 DB-IP를 확인하고 새로운 월간 릴리스가 있으면 다운로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica o DB-IP cerca de uma vez por dia e baixa uma versão mensal mais recente quando disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天检查一次 DB-IP，并在有更新的月度版本时下载。"
          }
        }
      }
    },
