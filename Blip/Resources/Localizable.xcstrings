    "Download the database first to enable automatic updates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade zuerst die Datenbank, um automatische Updates zu aktivieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga primero la base de datos para activar las actualizaciones automáticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez d'abord la base de données pour activer les mises à jour automatiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica prima il database per abilitare gli aggiornamenti automatici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動アップデートを有効にするには、先にデータベースをダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 업데이트를 사용하려면 먼저 데이터베이스를 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe o banco de dados primeiro para ativar as atualizações automáticas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先下载数据库以启用自动更新。"
          }
        }
      }
    },
    "Download the offline location database in\nSettings → Network to map the route.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade die Offline-Standortdatenbank unter\nEinstellungen → Netzwerk, um die Route anzuzeigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga la base de datos de ubicación sin conexión en\nAjustes → Red para trazar la ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez la base de données de localisation hors ligne dans\nRéglages → Réseau pour cartographier le trajet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica il database di localizzazione offline in\nImpostazioni → Rete per mappare il percorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経路をマッピングするには、設定 → ネットワークで\nオフラインの位置情報データベースをダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경로를 지도에 표시하려면\n설정 → 네트워크에서 오프라인 위치 데이터베이스를 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe o banco de dados de localização offline em\nAjustes → Rede para mapear a rota."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置 → 网络”中下载离线位置数据库，\n以绘制路由图。"
          }
        }
      }
    },
    "Downloading…": {
      "localizations": {
        "de": {
