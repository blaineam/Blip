    "How full this device is, and what's actually free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie voll dieses Gerät ist — und was wirklich frei ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuán lleno está este dispositivo y qué está libre de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le remplissage de cet appareil, et ce qui est vraiment libre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto è pieno questo dispositivo e cosa è davvero libero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの使用状況と、実際の空き容量。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 얼마나 찼는지, 실제로 남은 공간은 얼마인지."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O quanto este dispositivo está cheio e o que está realmente livre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备有多满，以及真正可用的空间。"
          }
        }
      }
    },
